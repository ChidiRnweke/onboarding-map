{
  "name": "onboarding-map",
  "version": "0.4.0",
  "description": "An onboarding map for any subject: a territory to recognise, a route to follow. Bring your own data; your coding agent writes it.",
  "keywords": [
    "onboarding",
    "learning",
    "map",
    "cli",
    "agent-skills",
    "claude-code",
    "sveltekit"
  ],
  "license": "MIT",
  "author": "Chidi Nweke",
  "homepage": "https://github.com/ChidiRnweke/onboarding-map#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChidiRnweke/onboarding-map.git"
  },
  "bugs": {
    "url": "https://github.com/ChidiRnweke/onboarding-map/issues"
  },
  "type": "module",
  "bin": {
    "onboarding-map": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./schema.json": "./schema/map.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "schema",
    "templates"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "npm run build:lib && vite dev",
    "build": "npm run build:lib && npm run build:schema && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && node -e \"require('fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "build:schema": "ts-json-schema-generator --path src/core/model.ts --type OnboardingMap --tsconfig tsconfig.lib.json --no-type-check -o schema/map.schema.json",
    "prepack": "npm run build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.lib.json --noEmit",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:embed": "ONBOARDING_BASE=/onboarding-map/embed/physics npm run build && node dist/cli/index.js build --map templates/physics.ts --out docs/public/embed/physics"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.48.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-color": "^3.1.3",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.19.0",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "d3-color": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "mode-watcher": "^1.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "ts-json-schema-generator": "^2.9.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  }
}
