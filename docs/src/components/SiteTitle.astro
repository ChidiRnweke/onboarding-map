---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="om-title">
  <svg class="om-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="9" fill="none" stroke="var(--rule)" stroke-width="1.2" />
    <circle cx="12" cy="12" r="5.4" fill="none" stroke="var(--rule-soft)" stroke-width="1" />
    <path
      d="M12 3.2 A8.8 8.8 0 0 1 19.35 8.1"
      fill="none"
      stroke="var(--route)"
      stroke-width="1.7"
      stroke-linecap="round"
    />
    <circle cx="12" cy="12" r="2.2" fill="var(--route)" />
  </svg>
  <span class="om-word">{siteTitle}</span>
  <span class="om-tag">docs</span>
</a>

<style>
  .om-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
    font-family: var(--serif);
    font-size: var(--sl-text-h4);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .om-mark {
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
  }
  .om-word {
    overflow: hidden;
  }
  .om-tag {
    font-family: var(--sans);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.05rem 0.4rem;
    transform: translateY(1px);
  }
</style>
