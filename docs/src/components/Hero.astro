---
// The landing page, in the map's own voice: a serif display line over a live
// map, framed like a panel. The iframe is the project's own map — the
// documentation, mapped with onboarding-map. See the root `docs:embed` script.
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const embedSrc = `${base}embed/project/`;

const actions = [
  { text: 'Get started', href: `${base}user-guide/getting-started/`, variant: 'primary' },
  { text: 'How it works', href: `${base}user-guide/overview/`, variant: 'secondary' },
];

// The map motif: rings and spokes, drawn faint, so the hero sits on the same
// territory the product draws.
const spokes = Array.from({ length: 12 }, (_, i) => i * 30);
---

<div class="om-hero">
  <div class="om-hero__copy">
    <p class="om-eyebrow">An onboarding map for anything</p>
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <div class="om-tagline" set:html={tagline} />}
    <div class="om-actions">
      {
        actions.map(({ text, href, variant }) => (
          <a class={`om-btn om-btn--${variant}`} href={href}>
            {text}
          </a>
        ))
      }
    </div>
  </div>

  <script is:inline>
    // Show the map itself, not the app's first-visit intro. Seed the flag before
    // the iframe below starts loading.
    try {
      localStorage.setItem('onboarding-map:onboarding-map:intro-seen', 'true');
    } catch {}
  </script>

  <figure class="om-stage">
    <svg class="om-motif" viewBox="0 0 400 300" aria-hidden="true" focusable="false">
      <g stroke="var(--rule-soft)" fill="none">
        <circle cx="200" cy="150" r="140" stroke-dasharray="2 6" />
        <circle cx="200" cy="150" r="100" stroke-dasharray="2 6" />
        <circle cx="200" cy="150" r="60" stroke-dasharray="2 6" />
        {spokes.map((deg) => <line x1="200" y1="150" x2="200" y2="10" transform={`rotate(${deg} 200 150)`} stroke-dasharray="2 8" />)}
      </g>
      <circle cx="200" cy="150" r="6" fill="var(--route)" />
    </svg>
    <div class="om-frame">
      <iframe
        id="om-embed"
        src={embedSrc}
        title="A live onboarding map: this project"
        loading="lazy"
      ></iframe>
    </div>
    <figcaption>
      A live map — this one is the documentation’s own. Drag it, follow the path.
      <a href={`${base}user-guide/examples/`}>See it next to its data</a>.
    </figcaption>
  </figure>
</div>

<script>
  // The embedded map resolves its own light/dark from the OS. Keep it in step
  // with the docs' theme toggle too: the frame is same-origin, so mirror the
  // data-theme Starlight puts on <html> onto the frame's root as .dark / .light
  // (the classes the app's own ModeWatcher uses).
  const frame = document.getElementById('om-embed') as HTMLIFrameElement | null;
  const sync = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    const root = frame?.contentDocument?.documentElement;
    if (!root) return;
    root.classList.toggle('dark', dark);
    root.classList.toggle('light', !dark);
  };
  frame?.addEventListener('load', sync);
  new MutationObserver(sync).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  sync();
</script>

<style>
  .om-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-block: clamp(2rem, 6vw, 4.5rem) 2rem;
    align-items: center;
  }

  .om-hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
    align-items: center;
  }

  .om-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  h1 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.015em;
    font-size: clamp(2rem, calc(0.5rem + 5vw), 3.25rem);
    max-width: 22ch;
  }

  .om-tagline {
    max-width: 48ch;
    font-family: var(--serif);
    font-size: clamp(1.05rem, calc(0.9rem + 1vw), 1.35rem);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .om-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .om-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 200ms var(--ease-panel),
      border-color 200ms var(--ease-panel);
  }
  .om-btn--primary {
    background: var(--route);
    color: var(--panel);
    border: 1px solid var(--route);
  }
  .om-btn--primary:hover {
    background: color-mix(in srgb, var(--route) 88%, black);
  }
  .om-btn--secondary {
    border: 1px solid var(--rule);
    color: var(--ink);
    background: transparent;
  }
  .om-btn--secondary:hover {
    border-color: var(--route);
  }

  .om-stage {
    position: relative;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .om-motif {
    position: absolute;
    inset: -15% -10% 5%;
    width: 120%;
    height: 120%;
    z-index: 0;
    opacity: 0.7;
    pointer-events: none;
    mask-image: radial-gradient(closest-side, black, transparent 85%);
  }
  .om-frame {
    position: relative;
    z-index: 1;
    border: 1px solid var(--rule);
    border-radius: var(--radius-xl);
    background: var(--panel);
    overflow: hidden;
    box-shadow: 0 18px 40px -28px rgb(0 0 0 / 0.55);
  }
  .om-frame iframe {
    display: block;
    width: 100%;
    height: min(62vh, 560px);
    border: 0;
    background: var(--paper);
  }
  .om-stage figcaption {
    position: relative;
    z-index: 1;
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-align: center;
  }
  .om-stage figcaption a {
    color: var(--route);
  }

  @media (min-width: 56rem) {
    .om-hero {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 3rem;
      padding-block: clamp(2.5rem, 6vw, 5rem) 3rem;
    }
    .om-hero__copy {
      text-align: start;
      align-items: flex-start;
    }
    .om-actions {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .om-btn {
      transition: none;
    }
  }
</style>
