---
// The assistant's provider setup, rendered from the same table the app's
// in-place setup uses (src/lib/agent/providers.ts), so a moved console link is
// fixed once and both places follow.
import { LOGOS } from '../../../src/lib/agent/logos';
import { PROVIDER_ORDER, PROVIDERS } from '../../../src/lib/agent/providers';

const generic =
  '<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>';
const fields = { key: 'API key', baseURL: 'Endpoint URL', model: 'Model' } as const;
---

<div class="providers not-content">
  {
    PROVIDER_ORDER.map((id) => {
      const p = PROVIDERS[id];
      return (
        <section class="provider" id={`provider-${id}`}>
          <header>
            <span class="logo" set:html={LOGOS[id] ?? generic} />
            <div>
              <h3>{p.label}</h3>
              <p class="pitch">{p.pitch}</p>
            </div>
          </header>
          <ol>
            {p.steps.map((step) => (
              <li>
                {step.text}
                {step.link && (
                  <a href={step.link.url} target="_blank" rel="noopener noreferrer">
                    {step.link.label} ↗
                  </a>
                )}
                {step.command && <code class="command">{step.command.replace('{origin}', 'https://your-map-address')}</code>}
              </li>
            ))}
          </ol>
          <p class="fields">
            Asks for: {p.needs.map((f) => (f === 'model' && id === 'azure' ? 'Deployment name' : fields[f])).join(', ')}
            {p.defaultModel && (
              <>
                {' '}
                · default model <code>{p.defaultModel}</code>
              </>
            )}
            {p.defaultBaseURL && (
              <>
                {' '}
                · endpoint <code>{p.defaultBaseURL}</code>
              </>
            )}
          </p>
          {p.notes.map((note) => (
            <p class="note">{note}</p>
          ))}
        </section>
      );
    })
  }
</div>

<style>
  .providers {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .provider {
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--panel);
    padding: 1rem 1.25rem;
  }
  header {
    display: flex;
    gap: 0.9rem;
    align-items: center;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
    font-size: 1.4rem;
  }
  h3 {
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink);
  }
  .pitch {
    margin: 0.1rem 0 0;
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  ol {
    margin: 0.9rem 0 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.45rem;
    font-size: 0.95rem;
  }
  li a {
    display: block;
    width: fit-content;
    font-weight: 600;
    color: var(--route);
  }
  .command {
    display: block;
    margin-top: 0.35rem;
    padding: 0.35rem 0.6rem;
    border-radius: 8px;
    background: var(--paper);
    font-size: 0.85rem;
    overflow-x: auto;
    white-space: nowrap;
  }
  .fields {
    margin: 0.8rem 0 0;
    color: var(--ink-2);
    font-size: 0.88rem;
  }
  .note {
    margin: 0.6rem 0 0;
    padding: 0.45rem 0.7rem;
    border-radius: 8px;
    background: var(--paper-2);
    color: var(--ink-2);
    font-size: 0.88rem;
  }
</style>
